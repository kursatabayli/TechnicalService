@page "/forgot-password"
@attribute [AllowAnonymous]

<PageTitle>Şifre Sıfırlama</PageTitle>

<MudPaper Class="form-container" Elevation="3">
    @if (!Submitting)
    {
        <MudForm Model="dto" @ref="form" Validation="@(Validator.ValidateValue)" ValidationDelay="0">
            <MudGrid Spacing="4" Justify="Justify.Center">

                <MudItem xs="12" sm="10" md="8" class="form-header">
                    <MudText Typo="Typo.h4" Color="Color.Primary" Class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.LockReset" Class="mr-2" />
                        Şifre Sıfırlama Talebi
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mt-1">
                        Lütfen şifrenizi sıfırlamak için aşağıdaki bilgileri eksiksiz ve doğru bir şekilde giriniz.
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="12" />

                <MudItem xs="12" sm="10" md="8">
                    <MudTextField @bind-Value="dto.Name"
                                  Label="Adınız"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  For="@(() => dto.Name)"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.PersonOutline"
                                  AdornmentColor="Color.Primary"
                                  Clearable
                                  FullWidth />
                </MudItem>

                <MudItem xs="12" sm="10" md="8">
                    <MudTextField @bind-Value="dto.Surname"
                                  Label="Soyadınız"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  For="@(() => dto.Surname)"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.PersonOutline"
                                  AdornmentColor="Color.Primary"
                                  Clearable
                                  FullWidth />
                </MudItem>

                <MudItem xs="12" sm="10" md="8">
                    <MudTextField @bind-Value="dto.IdentityNumber"
                                  Label="T.C. Kimlik Numarası"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  For="@(() => dto.IdentityNumber)"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Fingerprint"
                                  AdornmentColor="Color.Primary"
                                  Counter="11"
                                  Mask="@(new PatternMask("00000000000"))"
                                  Clearable
                                  FullWidth />
                </MudItem>

                <MudItem xs="12" sm="10" md="8">
                    <MudTextField @bind-Value="dto.Email"
                                  Label="Kayıtlı E-posta Adresiniz"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Email"
                                  For="@(() => dto.Email)"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                                  AdornmentColor="Color.Primary"
                                  Clearable
                                  FullWidth />
                </MudItem>

                <MudItem xs="12" sm="10" md="8">
                    <MudTextField @bind-Value="dto.InternalEmail"
                                  Label="Kurum E-postanız (varsa)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Email"
                                  For="@(() => dto.InternalEmail)"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.WorkOutline"
                                  AdornmentColor="Color.Primary"
                                  Clearable
                                  FullWidth />
                </MudItem>

                <MudItem xs="12" sm="10" md="8">
                    <MudDatePicker @bind-Date="dto.BirthDate"
                                   Label="Doğum Tarihiniz"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   DateFormat="dd.MM.yyyy"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Cake"
                                   AdornmentColor="Color.Primary"
                                   MinDate="@DateTime.Today.AddYears(-100)"
                                   MaxDate="@DateTime.Today.AddYears(-16)"
                                   PickerVariant="PickerVariant.Dialog"
                                   For="@(() => dto.BirthDate)"
                                   ShowToolbar="true"
                                   Clearable />
                </MudItem>

            </MudGrid>

            <MudStack Row="true" Spacing="3" Class="mt-6 mb-2" Justify="Justify.Center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="Submit"
                           Disabled="@Submitting"
                           StartIcon="@Icons.Material.Filled.Send"
                           Class="px-6">
                    @if (!Submitting)
                    {
                        <MudText>Şifreyi Sıfırla</MudText> @* veya "Sıfırlama Talebi Gönder" *@
                    }
                    else
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Gönderiliyor...</MudText>
                    }
                </MudButton>
            </MudStack>

            <MudGrid Justify="Justify.Center" Class="mt-3">
                <MudItem xs="12" sm="10" md="8" Class="text-center">
                    <MudLink Href="/login" Typo="Typo.body2">Giriş ekranına geri dön</MudLink>
                </MudItem>
            </MudGrid>

        </MudForm>
    }
    else
    {
        <Loading LoadingText="Bilgileriniz işleniyor, lütfen bekleyin..." />
    }
</MudPaper>
