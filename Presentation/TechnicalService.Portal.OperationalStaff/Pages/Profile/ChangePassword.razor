@page "/operational/change-password"
@layout OperationalStaffLayout
@using TechnicalService.DTOs.Enums
@attribute [Authorize(Policy = nameof(AppPolicies.OperationalStaff))]

<PageTitle>Şifre Değiştir</PageTitle>

    <MudPaper Class="form-container" Elevation="3">
        @if (!IsSubmitting)
        {
            <MudForm Model="@dto" @ref="@form" Validation="@(Validator.ValidateValue)" ValidationDelay="0">
                <MudGrid Spacing="3" Justify="Justify.Center">

                    <MudItem xs="12" class="form-header mb-4 text-center">
                        <MudText Typo="Typo.h4" Color="Color.Primary" Class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Class="mr-2" />
                            Şifre Değiştir
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Tertiary">
                            Yeni bir şifre belirleyin.
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" />

                    <MudItem xs="12" sm="10" md="10">
                        <PasswordField Label="Mevcut Şifre"
                                       @bind-Password="dto.CurrentPassword"
                                       ValidationExpression="@(() => dto.CurrentPassword)" />

                    </MudItem>

                    <MudItem xs="12" sm="10" md="10">
                        <PasswordField Label="Yeni Şifre"
                                       @bind-Password="dto.NewPassword"
                                       ValidationExpression="@(() => dto.NewPassword)" />
                    </MudItem>

                    <MudItem xs="12" sm="10" md="10">
                        <PasswordField Label="Yeni Şifre Tekrar"
                                       @bind-Password="dto.ApplyNewPassword"
                                       ValidationExpression="@(() => dto.ApplyNewPassword)" />
                    </MudItem>
                </MudGrid>

                <MudStack Row="true" Spacing="3" Class="mt-6 mb-2" Justify="Justify.Center">
                    <MudButton OnClick="NavigateBack"
                               Color="Color.Default"
                               Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               Class="px-6"
                               Disabled="@IsSubmitting">
                        Geri
                    </MudButton>
                    <MudButton OnClick="Submit"
                               Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@IsSubmitting"
                               Class="px-6">
                        @if (!IsSubmitting)
                        {
                            <MudText>Güncelle</MudText>
                        }
                        else
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Güncelleniyor...</MudText>
                        }
                    </MudButton>
                </MudStack>
            </MudForm>
        }
        else
        {
            <Loading LoadingText="Şifre değiştiriliyor..." />
        }
    </MudPaper>
