@using TechnicalService.DTOs.Enums
@using TechnicalService.Shared.Constants
@using TechnicalService.Shared.Services.Contracts
@using MudBlazor.Utilities;
@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="UIStateOption.isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView Policy="@nameof(AppPolicies.AdminOnly)">
    <Authorized>
        <MudLayout>
            <AppBar />
            <NavMenu />
            <MudMainContent Class="mt-16 pa-4">
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-8">
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private MudTheme? _theme = null;
    private UIStateOption UIStateOption { get; set; }
    [Inject] private IUIStateService UIStateService { get; set; }

    protected override void OnInitialized()
    {
        UIStateService.OnChange += HandleStateChange;
        UIStateService.LoadUIState();
        UIStateOption = UIStateService.UIState;
        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
            {
                DefaultBorderRadius = "6px",
                DrawerWidthLeft = "280px",
                DrawerWidthRight = "320px",
                AppbarHeight = "64px"
            },

        };
    }

    private void HandleStateChange()
    {
        UIStateOption = UIStateService.UIState;
        StateHasChanged();
    }

    public void Dispose() => UIStateService.OnChange -= HandleStateChange;

    private readonly PaletteLight _lightPalette = new()
    {
