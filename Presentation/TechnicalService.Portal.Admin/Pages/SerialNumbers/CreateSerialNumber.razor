@page "/admin/create-serial-number"
@layout AdminLayout
@attribute [Authorize(Policy = nameof(AppPolicies.AdminOnly))]
@using TechnicalService.DTOs.DTOs.ProductDTOs
@using TechnicalService.DTOs.Enums
@using TechnicalService.DTOs.DTOs.SerialNumberDTOs

<PageTitle>Seri Numarası Oluştur</PageTitle>

<MudPaper Class="form-container" Elevation="3">
    @if (!IsSubmitting)
    {
        <MudForm Model="@CreateSerialNumberDto" @ref="@form" Validation="@(Validator.ValidateValue)" ValidationDelay="0">
            <MudGrid Spacing="4" Justify="Justify.Center">

                <MudItem xs="12" sm="10" md="8" class="form-header">
                    <MudText Typo="Typo.h4" Color="Color.Primary" Class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Class="mr-2" />
                        Yeni Seri Numarası Oluştur
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mt-1">
                        Lütfen seri numarası bilgilerini giriniz.
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="12" />

                <MudItem xs="12" sm="10" md="8">
                    <MudTextField T="string"
                                  @bind-Value="CreateSerialNumberDto.Serial_Number"
                                  For="@(() => CreateSerialNumberDto.Serial_Number)"
                                  Immediate="true"
                                  Label="Seri Numarası"
                                  Placeholder="Örn: SN-12345ABCDE"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.DriveFileRenameOutline"
                                  AdornmentColor="Color.Primary"
                                  Clearable
                                  FullWidth />
                </MudItem>

                <MudItem xs="12" sm="10" md="8">
                    <MudAutocomplete T="ProductDto"
                                     @bind-Value="@CreateSerialNumberDto.Product"
                                     SearchFunc="SearchProducts"
                                     ToStringFunc="@(p => p == null ? string.Empty : $"{p.BrandName} - {p.ProductName} - {p.Type}")"
                                     For="@(() => CreateSerialNumberDto.Product)"
                                     Immediate="true"
                                     Label="Ürün"
                                     Placeholder="Ürün seçiniz veya yazmaya başlayın..."
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@Icons.Material.Filled.Widgets"
                                     AdornmentColor="Color.Primary"
                                     ResetValueOnEmptyText="true"
                                     Clearable
                                     FullWidth />
                </MudItem>

                <MudItem xs="12" sm="10" md="8">
                    <MudDatePicker Label="Kayıt Tarihi (Opsiyonel)"
                                   @bind-Date="CreateSerialNumberDto.RegisterDate"
                                   For="@(() => CreateSerialNumberDto.RegisterDate)"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Adornment="Adornment.Start"
                                   AdornmentIcon="@Icons.Material.Filled.Event"
                                   AdornmentColor="Color.Primary"
                                   DateFormat="dd.MM.yyyy"
                                   Clearable />
                </MudItem>

            </MudGrid>

            <MudStack Row="true" Spacing="3" Class="mt-6 mb-2" Justify="Justify.Center">
                <MudButton OnClick="NavigateBack"
                           Color="Color.Default"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Class="px-6">
                    Geri
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="Submit"
                           Disabled="@IsSubmitting"
                           Class="px-6">
                    @if (!IsSubmitting)
                    {
                        <MudText>Kaydet</MudText>
                    }
                    else
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Kaydediliyor...</MudText>
                    }
                </MudButton>
            </MudStack>
        </MudForm>
    }
    else
    {
        <Loading LoadingText="Seri numarası oluşturuluyor..." />
    }
</MudPaper>