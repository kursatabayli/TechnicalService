@using TechnicalService.DTOs.Enums
@using TechnicalService.DTOs.DTOs.PersonnelDTOs
@using TechnicalService.Shared.Extensions
@attribute [Authorize(Policy = nameof(AppPolicies.AdminOnly))]

<AuthorizeView>
    <MudDialog>
        <DialogContent>
            <MudGrid Class="pa-4" Spacing="4">
                @if (!IsSubmitting)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="d-flex align-center mb-4" Color="Color.Primary">
                            <MudIcon Icon="@Icons.Material.Filled.AddCircle" Class="mr-2" />
                            Servis Adımını Güncelle
                        </MudText>
                    </MudItem>

                    <MudItem xs="12">
                        <MudForm Model="UpdateServiceRecordDto" @ref="form" @onsubmit="Submit">
                            <MudSelect @bind-Value="UpdateServiceRecordDto.Status"
                                       T="ServiceStatusDto?"
                                       Label="Servis Durumu"
                                       Class="mb-4"
                                       Variant="Variant.Outlined"
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@GetStatusIcon()"
                                       AdornmentColor="@GetStatusColor()"
                                       FullWidth>
                                @foreach (var serviceStatus in Enum.GetValues<ServiceStatusDto>())
                                {
                                    <MudSelectItem T="ServiceStatusDto?" Value="@serviceStatus">@serviceStatus.GetDescription()</MudSelectItem>
                                }
                            </MudSelect>

                            <MudAutocomplete T="PersonnelDto"
                                             @bind-Value="SelectedPersonnel"
                                             SearchFunc="SearchPersonnel"
                                             ToStringFunc="StringFunc"
                                             ItemDisabledFunc="IsPersonnelDisabled"
                                             Label="Atanacak Personel"
                                             Class="mb-4"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.Start"
                                             AdornmentIcon="@Icons.Material.Filled.HomeRepairService"
                                             AdornmentColor="Color.Primary"
                                             Immediate="true"
                                             ResetValueOnEmptyText="true"
                                             CoerceValue="true"
                                             Clearable
                                             Dense="true" />

                        </MudForm>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" Class="text-center py-8">
                        <Loading />
                    </MudItem>
                }
            </MudGrid>
        </DialogContent>

        <DialogActions>
            @if (!IsSubmitting)
            {
                <MudButton OnClick="Cancel" Variant="Variant.Text">İptal</MudButton>
                <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled">Kaydet</MudButton>
            }
        </DialogActions>
    </MudDialog>
</AuthorizeView>