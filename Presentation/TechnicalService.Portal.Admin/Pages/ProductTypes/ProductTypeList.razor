@page "/admin/product-types"
@layout AdminLayout
@attribute [Authorize(Policy = nameof(AppPolicies.AdminOnly))]
@using TechnicalService.DTOs.Enums
@using TechnicalService.DTOs.DTOs.ProductTypeDTOs
@using TechnicalService.Portal.Admin.Constants

<PageTitle>Ürün Türleri</PageTitle>

<MudItem class="d-flex align-center justify-space-between mb-6">
    <MudText Typo="Typo.h4" Class="d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.Category" Class="mr-3" Color="Color.Primary" /> @* İkon güncellendi *@
        Ürün Türleri
    </MudText>
    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => NavigateToPage(AdminRouteConstants.AdminCreateProductTypes)">
        Yeni Ürün Türü Ekle
    </MudButton>
</MudItem>

<MudTable Items="@FilteredProductTypes"
          Hover="true"
          FixedHeader="true"
          Loading="@_isLoading"
          LoadingProgressColor="Color.Primary"
          Class="request-table">
    <ToolBarContent>
        <MudSpacer />
        <MudTextField @bind-Value="_searchText"
                      Placeholder="Ara..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Class="mt-0"
                      Clearable />
    </ToolBarContent>

    <HeaderContent>
        <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<ProductTypeDto, object>(x => _productTypes.IndexOf(x))">#</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<ProductTypeDto, object>(x => x.Type)">Ürün Türü</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center">İşlemler</MudTh>
    </HeaderContent>

    <LoadingContent>
        <Loading />
    </LoadingContent>

    <RowTemplate>
        <MudTd DataLabel="#">@(_productTypes.IndexOf(context) + 1)</MudTd>
        <MudTd DataLabel="Ürün Türü">@context.Type</MudTd>
        <MudTd DataLabel="İşlemler" Style="text-align:center">
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="mr-2"
                           OnClick='() => NavigateToPage(string.Format(AdminRouteConstants.AdminUpdateProductTypes, context.Id))' />
            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           Size="Size.Small"
                           OnClick="@(() => ShowDeleteConfirmationDialogAsync(context))" />
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudText Class="pa-4" Align="Align.Center">
            @if (_productTypes?.Any() == true && !string.IsNullOrEmpty(_searchText))
            {
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="mb-2" Style="font-size: 48px;" />
                <MudText Typo="Typo.h6">"@_searchText" ile eşleşen ürün türü bulunamadı.</MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Category" Class="mb-2" Style="font-size: 48px;" />
                <MudText Typo="Typo.h6">Kayıtlı ürün türü bulunmamaktadır.</MudText>
                <MudText Typo="Typo.body1" Class="mt-2">Yukarıdaki "Yeni Ürün Türü Ekle" butonu ile yeni bir ürün türü oluşturabilirsiniz.</MudText>
            }
        </MudText>
    </NoRecordsContent>

    <PagerContent>
        @if (FilteredProductTypes != null && FilteredProductTypes.Count() > 10)
        {
            <MudTablePager RowsPerPageString="Sayfa Başına Girdi" InfoFormat="{first_item}-{last_item} / {all_items}" />
        }
    </PagerContent>
</MudTable>
