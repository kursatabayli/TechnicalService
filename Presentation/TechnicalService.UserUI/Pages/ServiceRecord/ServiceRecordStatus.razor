@page "/service-record-status/{Id:guid}"
@attribute [Authorize(Policy = nameof(AppPolicies.UserAccesses))]
@using TechnicalService.DTOs.DTOs.ServiceRecordDTOs
@using TechnicalService.DTOs.DTOs.UserProductDTOs
@using TechnicalService.DTOs.Enums
@using TechnicalService.Shared.Extensions


<PageTitle>Onarım Durumu</PageTitle>

<MudPaper Class="pa-4 mb-6 rounded-lg" Elevation="3">
    <MudText Typo="Typo.h4" Class="d-flex align-center">
        <MudIcon Icon="@Icons.Material.Filled.Build" Class="status-header-icon" Size="Size.Large" />
        <span class="font-weight-bold">Servis Kaydı</span>
        <MudChip T="ServiceRecordDto" Color="GetStatusColor(ServiceRecordDto.Status)" Class="ml-3">@ServiceRecordDto.Status.GetDescription()</MudChip>
    </MudText>
</MudPaper>

@if (!LoadingData)
{


    <MudGrid Spacing="4" Class="mb-8">
        <MudItem xs="12" sm="6">
            <MudCard Class="detail-card" Elevation="1">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingBag" Size="Size.Medium" />
                    </CardHeaderAvatar>
                    <CardHeaderContent>Ürün Bilgileri</CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudList T="UserProductDto" Class="compact-icon-list">
                        <MudListItem Icon="@Icons.Material.Filled.Tag">
                            <MudText>@UserProduct.ProductName (@UserProduct.BrandName)</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Category">
                            <MudText>@UserProduct.Type</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.Numbers">
                            <MudText>Seri No: @UserProduct.Serial_Number</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.DateRange">
                            <MudText>Garanti: @UserProduct.WarrantyDate.ToString("dd.MM.yyyy")</MudText>
                        </MudListItem>
                    </MudList>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudCard Class="detail-card" Elevation="1">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Medium" />
                    </CardHeaderAvatar>
                    <CardHeaderContent>Kullanıcı Şikayeti</CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.h6" GutterBottom="true">
                        @ServiceRecordDto.Title
                    </MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                        @ServiceRecordDto.Id.ToString().Substring(0, 8).ToUpper()
                    </MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                        @ServiceRecordDto.CreatedDate.ToString("dd MMMM yyyy, HH:mm")
                    </MudText>

                    <MudText Typo="Typo.body1">
                        @ServiceRecordDto.Description
                    </MudText>

                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudPaper Class="rounded-lg" Elevation="1">
        <MudCard>
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Medium" />
                </CardHeaderAvatar>
                <CardHeaderContent>Süreç Takibi</CardHeaderContent>
            </MudCardHeader>

            <MudCardContent>

                <MudStepper Vertical="true" NonLinear="@(!ServiceRecordDto.IsCompleted)" Class="pl-4" ActiveIndex="serviceRecordSteps.Count()" CompletedStepColor="Color.Success">
                    <ChildContent>
                        <MudStep Title="Ürün Bekleniyor" Completed="@serviceRecordSteps.Any()">
                            <ChildContent>

                                <MudItem Class="step-description pa-4 my-2 rounded">
                                    <MudText Typo="Typo.body2" Class="text-grey-darken-2">
                                        Ürününüz servisimize ulaştığında işlemlere başlanacaktır. Lütfen size en yakın servisimize ürünüzü teslim ediniz.
                                        Eğer şehrinizde servis bulunmuyorsa müşteri hizmetlerimize ulaşarak kargo kodu talep edebilirsiniz.
                                        <br />
                                        <MudLink Href="/Locations" Target="_blank" Color="Color.Primary">Servislerimizi görüntülemek için tıklayın</MudLink>
                                    </MudText>

                                </MudItem>
                            </ChildContent>

                        </MudStep>

                        @foreach (var step in serviceRecordSteps)
                        {
                            <MudStep Title="@step.StepTitle" Completed="@step.IsCompleted">
                                <ChildContent>
                                    <MudText Color="Color.Secondary">@step.CreatedDate.ToString("dd.MM.yyyy HH:mm")</MudText>
                                    <MudItem Class="step-description pa-4 my-2 rounded">
                                        <MudText Typo="Typo.body2" Class="text-grey-darken-2">
                                            @step.StepDescription
                                        </MudText>
                                    </MudItem>
                                </ChildContent>

                            </MudStep>
                        }
                    </ChildContent>
                    <CompletedContent>
                        <MudText Typo="Typo.body2" Class="text-grey-darken-2">
                            @serviceRecordSteps.Last().StepDescription
                        </MudText>
                    </CompletedContent>
                </MudStepper>
            </MudCardContent>

        </MudCard>

    </MudPaper>
    <MudAlert Class="mt-6" Elevation="2" Severity="Severity.Info" Variant="Variant.Filled">
        <MudText>Yardıma mı ihtiyacınız var?</MudText>
        <MudLink Href="/Contact" Target="_blank" Color="Color.Surface">İletişim</MudLink> adreslerimizden bize ulaşabilirsiniz.
    </MudAlert>
}
else
{
    <Loading />
}
