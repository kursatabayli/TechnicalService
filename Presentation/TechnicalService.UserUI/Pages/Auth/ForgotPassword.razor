@page "/forgot-password"
@attribute [AllowAnonymous]

<PageTitle>Şifre Sıfırlama</PageTitle>

<MudPaper Class="form-container" Elevation="3">
    @if (!Submitting)
    {
        <MudForm Model="dto" @ref="form" ValidationDelay="0">
            <MudGrid Spacing="4" Justify="Justify.Center">

                <MudItem xs="12" sm="10" md="8" class="form-header">
                    <MudText Typo="Typo.h4" Color="Color.Primary" Class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.LockReset" Class="mr-2" />
                        Şifre Sıfırlama Talebi
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mt-1">
                        Şifrenizi sıfırlamak için lütfen kayıtlı e-posta adresinizi giriniz. Size bir sıfırlama bağlantısı göndereceğiz.
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="12" />

                <MudItem xs="12" sm="10" md="8">
                    <MudTextField @bind-Value="dto.Email"
                                  Label="E-posta Adresiniz"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="InputType.Email"
                                  For="@(() => dto.Email)"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                                  AdornmentColor="Color.Primary"
                                  Placeholder="eposta@example.com"
                                  Clearable
                                  FullWidth />
                </MudItem>

            </MudGrid>

            <MudStack Row="true" Spacing="3" Class="mt-6 mb-2" Justify="Justify.Center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="Submit"
                           Disabled="@Submitting"
                           StartIcon="@Icons.Material.Filled.Send"
                           Class="px-6">
                    @if (!Submitting)
                    {
                        <MudText>Sıfırlama Bağlantısı Gönder</MudText>
                    }
                    else
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Gönderiliyor...</MudText>
                    }
                </MudButton>
            </MudStack>

            <MudGrid Justify="Justify.Center" Class="mt-3">
                <MudItem xs="12" sm="10" md="8" Class="text-center">
                    <MudLink Href="/login" Typo="Typo.body2">Giriş ekranına geri dön</MudLink>
                </MudItem>
            </MudGrid>

        </MudForm>
    }
    else
    {
        <Loading LoadingText="Şifre sıfırlama bağlantısı gönderiliyor..." />
    }
</MudPaper>